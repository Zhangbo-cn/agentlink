# systemd unit for running without Docker. Put the repo at /opt/agentlink, run
# `npm ci --omit=dev && npm run build` there (or `npm ci` for a full checkout), then:
#   sudo useradd -r -s /usr/sbin/nologin agentlink && sudo systemctl enable --now agentlink
[Unit]
Description=AgentLink relay
After=network-online.target

[Service]
User=agentlink
WorkingDirectory=/opt/agentlink
EnvironmentFile=/etc/agentlink.env
Environment=AGENTLINK_DATA_DIR=/var/lib/agentlink
StateDirectory=agentlink
ExecStart=/usr/bin/node bin/agentlink-server.mjs
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/agentlink

[Install]
WantedBy=multi-user.target
