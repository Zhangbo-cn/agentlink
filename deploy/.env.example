# Public hostname (Caddy obtains a TLS certificate for it automatically)
AGENTLINK_DOMAIN=relay.example.com
AGENTLINK_PUBLIC_URL=https://relay.example.com

# Who can create accounts:
#   email  - anyone who verifies an email address (default)
#   invite - only emails/accounts created by the admin
#   open   - no verification (trusted LAN / development only)
AGENTLINK_SIGNUP=email
# Optional: restrict sign-up to these email domains (comma-separated)
AGENTLINK_EMAIL_DOMAINS=

# ---- Email delivery for sign-in codes (without it, codes are written to the server log)
# Option A: provider preset. Run `agentlink-server smtp-presets` for the list:
#   qq, exmail (腾讯企业邮), 163, 126, yeah, 163qiye, aliyun, gmail, outlook, sendgrid, ses
# QQ/163/126: enable SMTP in the mailbox settings and use the generated 授权码 as the password.
# Gmail: turn on 2-Step Verification and create an App Password.
AGENTLINK_SMTP_PROVIDER=
AGENTLINK_SMTP_USER=
AGENTLINK_SMTP_PASS=
# Option B: full URL, e.g. smtps://bot%40qq.com:AUTHCODE@smtp.qq.com:465
AGENTLINK_SMTP_URL=
# Leave empty: defaults to the SMTP login address (QQ/163/Gmail reject anything else).
AGENTLINK_MAIL_FROM=
# Check settings: docker compose run --rm agentlink node --experimental-transform-types server/src/main.ts test-mail you@example.com

# Admin API (agentlink-admin). Generate with: openssl rand -hex 32
AGENTLINK_ADMIN_TOKEN=
AGENTLINK_METRICS_TOKEN=

# Webhook targets: public (https, no private IPs; default) | private (allow LAN) | off
AGENTLINK_WEBHOOKS=public

# Fair-use limits per account (0 = unlimited). There are no paid tiers.
AGENTLINK_MONTHLY_MESSAGES=0
AGENTLINK_MAX_DEVICES=50
AGENTLINK_MAX_ONLINE_AGENTS=100
AGENTLINK_MAX_ATTACHMENT_BYTES=26214400
AGENTLINK_QUEUE_TTL_SEC=604800

LOG_LEVEL=info
